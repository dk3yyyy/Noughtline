PORT=3000
NODE_ENV=development
DATABASE_PATH=./tic-tac.db
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=30d
CORS_ORIGINS=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
ROOM_ACTION_RATE_LIMIT=30
ROOM_ACTION_RATE_WINDOW_MS=60000

# Leave empty in local development. Paid currency remains disabled until configured.
PAYSTACK_SECRET_KEY=

# Leave empty in local development. Google account linking stays disabled (fail-closed)
# until this is set to a Google Cloud OAuth 2.0 client ID.
GOOGLE_CLIENT_ID=
