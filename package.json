{
  "name": "noughtline",
  "private": true,
  "version": "0.0.0",
  "description": "Noughtline — competitive multiplayer tic-tac-toe with AI and private rooms.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "server": "node server/index.js",
    "dev:all": "concurrently -k \"npm run server\" \"npm run dev\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "npm --prefix server test"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^12.30.1",
    "lucide-react": "^0.563.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^8.1.4"
  }
}
